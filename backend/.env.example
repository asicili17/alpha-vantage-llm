# Django settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite is default, uncomment for Postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Keys
