# Django settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite is default, uncomment for Postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Keys
OPENAI_API_KEY=your-openai-api-key
ALPHAVANTAGE_API_KEY=your-alphavantage-api-key

# Alpha Vantage MCP Configuration
ALPHAVANTAGE_MCP_TRANSPORT=http
ALPHAVANTAGE_MCP_URL=https://mcp.alphavantage.co/mcp
# ALPHAVANTAGE_MCP_COMMAND=uvx
# ALPHAVANTAGE_MCP_ARGS=["marketdata-mcp-server"]

# OpenAI Model Configuration
# Using gpt-4o-mini for all operations (cost-effective and capable)
OPENAI_MODEL=gpt-4o-mini
